name: Deploy EarLab to GitHub Pages

on:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Validate static app
        shell: bash
        run: |
          test -f index.html
          test -f app.js
          test -f styles.css
          node --check app.js
          python - <<'PY'
          from html.parser import HTMLParser
          from pathlib import Path
          from urllib.parse import urlsplit

          class Check(HTMLParser):
              def __init__(self):
                  super().__init__()
                  self.ids = []
                  self.refs = []

              def handle_starttag(self, tag, attrs):
                  attrs = dict(attrs)
                  if "id" in attrs:
                      self.ids.append(attrs["id"])
                  if tag in {"script", "link"}:
                      ref = attrs.get("src") or attrs.get("href")
                      if ref and not ref.startswith(("http://", "https://", "#")):
                          self.refs.append(ref)

          check = Check()
          check.feed(Path("index.html").read_text(encoding="utf-8"))
          assert len(check.ids) == len(set(check.ids)), "duplicate HTML ids"
          for ref in check.refs:
              local = urlsplit(ref).path
              assert Path(local).exists(), f"missing local asset: {ref}"
          print("index.html validation passed")
          PY

      - name: Configure Pages
        uses: actions/configure-pages@v5

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: .

  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4



